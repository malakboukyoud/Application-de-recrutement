<script>
document.addEventListener('DOMContentLoaded', function () {

    /* =========================================================
       ELEMENTS
    ========================================================= */

    const notificationButton =
        document.getElementById('notificationButton');

    const notificationPanel =
        document.getElementById('notificationPanel');

    const userMenuButton =
        document.getElementById('userMenuButton');

    const userMenuPanel =
        document.getElementById('userMenuPanel');


    /* =========================================================
       NOTIFICATIONS
    ========================================================= */

    if (notificationButton && notificationPanel) {

        notificationButton.addEventListener('click', function (event) {

            event.preventDefault();
            event.stopPropagation();

            /*
             * Fermer le menu utilisateur
             */
            if (userMenuPanel) {
                userMenuPanel.classList.remove('active');
            }

            /*
             * Ouvrir / fermer les notifications
             */
            notificationPanel.classList.toggle('active');

        });

    }


    /* =========================================================
       MENU UTILISATEUR
    ========================================================= */

    if (userMenuButton && userMenuPanel) {

        userMenuButton.addEventListener('click', function (event) {

            event.preventDefault();
            event.stopPropagation();

            /*
             * Fermer les notifications
             */
            if (notificationPanel) {
                notificationPanel.classList.remove('active');
            }

            /*
             * Ouvrir / fermer le menu utilisateur
             */
            userMenuPanel.classList.toggle('active');

        });

    }


    /* =========================================================
       CLIQUER À L'EXTÉRIEUR
    ========================================================= */

    document.addEventListener('click', function (event) {

        /*
         * Fermer le panneau notifications
         */
        if (
            notificationPanel &&
            notificationButton &&
            !notificationPanel.contains(event.target) &&
            !notificationButton.contains(event.target)
        ) {

            notificationPanel.classList.remove('active');

        }


        /*
         * Fermer le menu utilisateur
         */
        if (
            userMenuPanel &&
            userMenuButton &&
            !userMenuPanel.contains(event.target) &&
            !userMenuButton.contains(event.target)
        ) {

            userMenuPanel.classList.remove('active');

        }

    });


    /* =========================================================
       EMPÊCHER LA FERMETURE DU PANEL NOTIFICATIONS
       LORSQU'ON CLIQUE DEDANS
    ========================================================= */

    if (notificationPanel) {

        notificationPanel.addEventListener(
            'click',
            function (event) {

                event.stopPropagation();

            }
        );

    }


    /* =========================================================
       EMPÊCHER LA FERMETURE DU MENU UTILISATEUR
       LORSQU'ON CLIQUE DEDANS
    ========================================================= */

    if (userMenuPanel) {

        userMenuPanel.addEventListener(
            'click',
            function (event) {

                event.stopPropagation();

            }
        );

    }


    /* =========================================================
       RECHERCHE DES OFFRES
    ========================================================= */

    const search =
        document.getElementById('tableSearch');

    const typeFilter =
        document.getElementById('typeFilter');

    const statutFilter =
        document.getElementById('statutFilter');

    const table =
        document.getElementById('offresTable');


    function filtrerOffres() {

        /*
         * Vérifier que le tableau existe
         */
        if (!table) {
            return;
        }


        /*
         * Récupérer les valeurs
         */
        const texte =
            search
                ? search.value.toLowerCase().trim()
                : '';

        const typeChoisi =
            typeFilter
                ? typeFilter.value.toLowerCase().trim()
                : '';

        const statutChoisi =
            statutFilter
                ? statutFilter.value.toLowerCase().trim()
                : '';


        /*
         * Récupérer les lignes
         */
        const rows =
            table.querySelectorAll('tbody tr');


        /*
         * Parcourir les lignes
         */
        rows.forEach(function (row) {

            /*
             * Vérifier que c'est une vraie ligne
             */
            if (row.cells.length < 8) {
                return;
            }


            /*
             * Contenu complet de la ligne
             */
            const contenu =
                row.innerText.toLowerCase();


            /*
             * Colonne Type
             * ID       = 0
             * Référence = 1
             * Intitulé = 2
             * Type     = 3
             */
            const typeOffre =
                row.cells[3]
                    ? row.cells[3].innerText
                        .toLowerCase()
                        .trim()
                    : '';


            /*
             * Colonne Statut
             */
            const statutOffre =
                row.cells[7]
                    ? row.cells[7].innerText
                        .toLowerCase()
                        .trim()
                    : '';


            /*
             * Vérifier la recherche
             */
            const okRecherche =
                texte === '' ||
                contenu.includes(texte);


            /*
             * Vérifier le type
             */
            const okType =
                typeChoisi === '' ||
                typeOffre === typeChoisi;


            /*
             * Vérifier le statut
             */
            const okStatut =
                statutChoisi === '' ||
                statutOffre.includes(statutChoisi);


            /*
             * Afficher / cacher
             */
            if (
                okRecherche &&
                okType &&
                okStatut
            ) {

                row.style.display = '';

            } else {

                row.style.display = 'none';

            }

        });

    }


    /* =========================================================
       EVENEMENT RECHERCHE
    ========================================================= */

    if (search) {

        search.addEventListener(
            'input',
            filtrerOffres
        );

    }


    /* =========================================================
       EVENEMENT FILTRE TYPE
    ========================================================= */

    if (typeFilter) {

        typeFilter.addEventListener(
            'change',
            filtrerOffres
        );

    }


    /* =========================================================
       EVENEMENT FILTRE STATUT
    ========================================================= */

    if (statutFilter) {

        statutFilter.addEventListener(
            'change',
            filtrerOffres
        );

    }


    /* =========================================================
       ESCAPE = FERMER LES MENUS
    ========================================================= */

    document.addEventListener(
        'keydown',
        function (event) {

            if (event.key === 'Escape') {

                if (notificationPanel) {

                    notificationPanel.classList.remove(
                        'active'
                    );

                }

                if (userMenuPanel) {

                    userMenuPanel.classList.remove(
                        'active'
                    );

                }

            }

        }
    );


    /* =========================================================
       INITIALISATION
    ========================================================= */

    filtrerOffres();


});
</script>


<!-- =========================================================
     BOOTSTRAP JAVASCRIPT
========================================================= -->

