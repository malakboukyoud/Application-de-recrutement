    color:var(--red);

}

.ormvasm-alert-content{

    flex:1;

}

.ormvasm-alert-content strong{

    display:block;

    font-size:13px;

    color:var(--text);

}

.ormvasm-alert-content span{

    display:block;

    margin-top:4px;

    color:var(--text-light);

    font-size:11px;

}

