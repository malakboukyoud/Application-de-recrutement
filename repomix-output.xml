.ormvasm-status::before{

    content:"";

    width:6px;

    height:6px;

    border-radius:50%;

    background:currentColor;

}

.ormvasm-status.green{

    color:var(--green);

    background:var(--green-light);

}

.ormvasm-status.orange{

    color:var(--orange);

    background:var(--orange-light);

}

.ormvasm-status.blue{

